source "https://rubygems.org"

# The site is built by GitHub Actions (.github/workflows/pages.yml), not by
# GitHub Pages' native Jekyll build, so we are free to run a current Jekyll.
# Local and CI use this same Gemfile, so `jekyll serve` matches production.
gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-redirect-from"
end
